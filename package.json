{
  "name": "attackgraph-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @attackgraph/backend",
    "dev:frontend": "npm run dev -w @attackgraph/frontend",
    "build": "npm run build -w @attackgraph/backend && npm run build -w @attackgraph/frontend",
    "clear": "npm run clear -w @attackgraph/backend",
    "seed:sample": "npm run seed:sample -w @attackgraph/backend",
    "seed:generic": "npm run seed:generic -w @attackgraph/backend",
    "db:migrate": "npm run db:migrate -w @attackgraph/backend --",
    "legacy:attach": "npm run legacy:attach -w @attackgraph/backend --",
    "legacy:confirm-appendix-d-source": "npm run legacy:confirm-appendix-d-source -w @attackgraph/backend --",
    "standard:f3532:import": "npm run standard:f3532:import -w @attackgraph/backend",
    "exp:do356a:baseline": "npm run exp:do356a:baseline -w @attackgraph/backend",
    "vg1:demo": "npm run vg1:demo -w @attackgraph/backend",
    "phase3:demo": "npm run phase3:demo -w @attackgraph/backend",
    "phase4:demo": "npm run phase4:demo -w @attackgraph/backend",
    "phase5:demo": "npm run phase5:demo -w @attackgraph/backend",
    "phase6:recovery-drill": "npm run phase6:recovery-drill -w @attackgraph/backend",
    "phase7:acceptance": "npm run phase7:acceptance -w @attackgraph/backend --",
    "verify:responsive": "npm run verify:responsive -w @attackgraph/frontend"
  },
  "dependencies": {
    "mammoth": "^1.12.0"
  }
}
